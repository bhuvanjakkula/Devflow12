{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "env": {
    "DEVFLOW_OWNER_MODE": "1",
    "DEVFLOW_PUBLIC_ACCESS": "1",
    "DEVFLOW_DB": "/tmp/devflow.sqlite3"
  }
}
